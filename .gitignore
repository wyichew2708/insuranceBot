__pycache__/
*.py[cod]
.venv/
*.egg-info/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
.env
.traces/
# `mlx-openai-server` writes here from whatever directory it was started in.
logs/
.eval-reports/
node_modules/
.DS_Store

# Claude Code's local state. `launch.json` is committed — it defines the dev
# servers and is worth sharing; the worktrees underneath it are not.
.claude/*
!.claude/launch.json

# Build output: `make knowledge` regenerates it from the crawler + fixture.
# It is synthetic content and must never be mistaken for a real corpus.
okf-web/
# `okf-real/` — the compiled Etiqa/Tiq corpus — is COMMITTED. It is the thing
# the chatbot serves, and a deployment that has to crawl two websites and parse
# 300 PDFs before it can answer anything is not a deployment. Regenerate it
# with `make corpus`; the sources it cites travel with it, because the
# quotation check and the RAG fallback both read them at answer time.
# What stays out is the backup a re-crawl leaves behind.
okf-real.prev/
okf-live/

# Scan staging: each scan crawls and compiles into its own throwaway bundle.
.scan/
