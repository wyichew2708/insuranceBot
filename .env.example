# LLM endpoints (external, OpenAI-compatible)
VLLM_AGENT_BASE_URL=
VLLM_AGENT_MODEL=
VLLM_JUDGE_BASE_URL=
VLLM_JUDGE_MODEL=
VLLM_EMBED_BASE_URL=
VLLM_EMBED_MODEL=
VLLM_RERANK_BASE_URL=
VLLM_RERANK_MODEL=
VLLM_API_KEY=

# Knowledge bundle (external CMS output)
KB_BUNDLE_GIT_URL=
KB_BUNDLE_GIT_REF=main
KB_PUBLISH_STREAM=kb.publish

# State
DATABASE_URL=postgresql+psycopg://bot:bot@localhost:5432/bot
REDIS_URL=redis://localhost:6379

# Observability
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Crawler
CRAWL_ALLOWLIST=www.etiqa.com.sg,www.tiq.com.sg
CRAWL_DEFAULT_REFRESH_HOURS=24
CRAWL_PROMO_REFRESH_HOURS=6

# Runtime
BRANDS=etiqa,tiq
AGENT_MAX_STEPS=6
VERIFY_MAX_RETRIES=1
SESSION_TTL_MINUTES=60
EVAL_GATE=0.95

# Internal service URLs
ORCHESTRATOR_URL=http://localhost:8001
RETRIEVAL_URL=http://localhost:8002

# Sessions & data protection
SESSION_SECRET=
WIDGET_KEYS=
MESSAGE_ENC_KEY=
MESSAGE_TTL_DAYS=90
