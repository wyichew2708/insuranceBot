# Copy to `.env` and fill in what you need:
#
#     cp .env.example .env
#
# `.env` is gitignored; this template is not, so never put a real key here.
#
# Everything below is optional. With none of it set the serve loop runs fully
# deterministically — no network, no credentials, no cost — which is what keeps
# the console, the test suite and the eval harness usable offline.
#
# Settings are read from the working directory, so `.env` belongs at the
# repository root and `make` should be run from there. The Docker targets pass
# `--project-directory .` so the container reads this same file.

# ---------------------------------------------------------------------------
# Generation — who writes the prose
# ---------------------------------------------------------------------------
# `auto` resolves from whatever credentials are present; with none, that is the
# deterministic composer. Numbers never come from a model on any setting: the
# composer resolves them from the benefit tables and the numeric-binding gate
# blocks anything that does not trace to a row.
#   auto | deterministic | anthropic | vllm
LLM_PROVIDER=auto

# --- Hosted (Anthropic) ---
# This key also turns on the guardrail model layer; screening shares the
# provider and there is no separate guardrail credential. Leave empty if you
# have run `ant auth login` — the SDK resolves the stored profile.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Local (any OpenAI-compatible server: vLLM, mlx-openai-server, LM Studio) ---
# The server must honour `response_format: json_schema`. Stock `mlx_lm.server`
# does not, and fails silently — every call falls back to the deterministic
# composer while looking configured.
#
# On Apple Silicon, run the model on the host rather than in a container:
#   mlx-openai-server launch --model-type lm --port 8090 \
#     --model-path mlx-community/Qwen3.6-35B-A3B-OptiQ-4bit \
#     --served-model-name qwen3.6-35b-a3b
#
# From the host:      http://127.0.0.1:8090
# From a container:   http://host.docker.internal:8090
VLLM_BASE_URL=
VLLM_MODEL=

# ---------------------------------------------------------------------------
# Guardrails — screening the question in and the answer out
# ---------------------------------------------------------------------------
# The deterministic rule layer always runs and is not switchable. This decides
# only whether a model reads the turn as well.
#   auto | rules | off
GUARDRAILS=auto

# Overrides the model for the two screening calls, not the credentials. A fully
# configured turn makes three calls — screen the question, write the answer,
# screen the answer — so a smaller model here is usually the right trade
# against the one writing the answer.
#
# Model names belong to providers. Pointing LLM_PROVIDER at a local server
# while this still names a hosted model asks that server for something it has
# never heard of; the guard retries once on the provider's own model and
# records `dropped_model_override` on the trace, but clearing it is cleaner.
# Leave empty to use whatever model the provider is already serving.
GUARDRAIL_MODEL=

# What an unscreened turn is worth. A configured screening model that goes
# silent leaves the rule layer intact either way; this decides whether the turn
# is still answered. Open by default so an outage degrades the check rather
# than the service — close it for a regulated deployment.
GUARDRAIL_FAIL_CLOSED=false

# ---------------------------------------------------------------------------
# Retrieval — vectors (v2.1)
# ---------------------------------------------------------------------------
# Dense retrieval over pgvector, fused with the lexical rank. Recall only: a
# chunk found by similarity is a candidate under the same frontmatter filter,
# composition and gates as one found by words. With everything below empty the
# API runs exactly as it did without it.
#
#   auto | on | off
# `auto` resolves from the DSN — empty means lexical only, no stage opened, no
# connection tried. `on` fails a turn if the database is down, for testing the
# path. `off` never opens a connection. The trace records which path served
# every turn as `retrieval_mode`, and an evaluation refuses to score a "hybrid"
# run that was served lexically because the database was unreachable.
PGVECTOR=auto
# Postgres with the pgvector extension. On the GPU host this is the `postgres`
# service under the `gpu` profile; from the Mac, point it at that host.
#   postgresql://okf:okf@gpu-host:5432/okf
PGVECTOR_DSN=
# Where questions are embedded: an OpenAI-compatible /v1/embeddings endpoint.
# TEI serving BAAI/bge-m3 (multilingual — Malay, Chinese and Tamil questions
# all appeared in the field test). Pages are embedded offline by `make index`,
# never on the request path; the API embeds only the question. A mismatch
# between the served bundle and the index is reported on /readyz, not served.
#   http://gpu-host:8080/v1
EMBED_BASE_URL=
EMBED_MODEL=BAAI/bge-m3
# Optional cross-encoder over the fused top-20. Empty means the fused ranking
# stands. TEI serving BAAI/bge-reranker-v2-m3.
#   http://gpu-host:8081
RERANK_BASE_URL=
# What an unreachable database is worth. Open by default, like the guardrail
# screen: an outage degrades recall to the lexical path, not the service.
PGVECTOR_FAIL_CLOSED=false

# ---------------------------------------------------------------------------
# Corpus and serving
# ---------------------------------------------------------------------------
# Which compiled bundle the API serves.
#
#   okf       the seed bundle: three products, hand-checked, always present.
#   okf-real  the Etiqa/Tiq corpus: 100+ products compiled from the two
#             websites, their published FAQs, and 220 policy wordings and
#             product summaries. Committed, so a checkout can serve it.
#   okf-web   synthetic fixture content from `make knowledge` — useful for
#             volume, never for real figures.
#
# okf-real is signed off `UNREVIEWED-eval-only`: the pages are compiled and
# measurable, and no human has read them. See the README before serving it to
# anyone who is not you.
BUNDLE_PATH=okf

# Host port for the Docker targets. The app always listens on 8080 inside the
# container.
API_PORT=8080
