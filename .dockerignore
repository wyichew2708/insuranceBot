# Keep the build context small and free of anything secret or regenerable.
.git/
.venv/
.claude/
__pycache__/
*.py[cod]
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
.env
.traces/
.eval-reports/
.scan/
node_modules/
# Generated corpora: build output, large, and rebuilt by `make knowledge`.
# `okf-real/` is committed but stays out of the *image*: compose bind-mounts it
# read-only, so baking a 20MB corpus into every layer buys nothing and means a
# recompiled bundle needs a rebuilt image.
okf-web/
okf-real/
okf-live/
